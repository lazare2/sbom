# SBOM Platform — settings for a `docker compose up -d --build` deployment.
#
#   cp .env.docker.example .env
#
# This is the file to copy after a `git clone`. `.env.example` next to it is for a
# native development run: it points DATABASE_URL at localhost and PUBLIC_URL at the
# Vite port, and a compose deployment that inherits PUBLIC_URL=...:5173 rejects the
# browser's own requests as cross-origin. Compose supplies DATABASE_URL itself, so
# it is deliberately absent here.
#
# Everything not listed has a working default in docker-compose.yml.

# --- required ---------------------------------------------------------------

# Signs session cookies. 32+ random characters. Generate, do not invent:
#   docker run --rm alpine sh -c "head -c32 /dev/urandom | base64"
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Generate a separate one per deployment: two machines sharing a value can forge
# each other's sessions. Changing it later signs everyone out.
SESSION_SECRET=

# The first administrator, created on first boot only. The "email" is a login
# identifier, not a mailbox — the platform never sends mail, so it need not be
# deliverable. There is no self-service reset; another admin resets it.
BOOTSTRAP_ADMIN_EMAIL=admin@sbom.local
BOOTSTRAP_ADMIN_PASSWORD=

# --- recommended ------------------------------------------------------------

# How this deployment is actually reached, if not localhost. Sets the allowed CORS
# origin and whether the session cookie gets the Secure flag. Include the port.
#PUBLIC_URL=http://192.168.1.50:8080

# PostgreSQL password. Defaults to `sbom`. The database is published on loopback
# only, but set this on any machine other people can log into.
#POSTGRES_PASSWORD=

# Shared bearer tokens for CI pipelines, as `label:token` pairs, comma-separated.
# Generate them the same way as SESSION_SECRET. A pipeline sends:
#   Authorization: Bearer <token>
# More can be issued in the admin panel; these exist so CI works before that.
#INGEST_TOKENS=jenkins:REPLACE_ME,gitlab:REPLACE_ME

# --- optional ---------------------------------------------------------------

# An active application with no build for this many days is reported as stale.
#STALE_APP_THRESHOLD_DAYS=30

# Vulnerability scanning is OFF until an administrator enables it in the admin
# panel; there is no environment variable for the flag. Grype ships inside the API
# image, but its database (~1.9 GB expanded) does not — install it once with
# "Update now" under Admin -> Vulnerability scanning.
#
# Point at an internal mirror to keep database traffic inside the network.
#GRYPE_DB_UPDATE_URL=https://grype.anchore.io/databases
# For a mirror behind a TLS-inspecting proxy or a private CA (path in the container).
#GRYPE_DB_CA_CERT=

#LOG_LEVEL=info
