{
  "name": "@sbom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:seed:prod": "node dist/db/seed.js",
    "db:studio": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs studio",
    "test": "vitest run test/unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "db:seed:demo": "tsx --env-file-if-exists=../../.env src/db/seed-demo.ts",
    "db:seed:drift": "tsx --env-file-if-exists=../../.env src/db/seed-drift-demo.ts",
    "db:backfill:platform": "tsx --env-file-if-exists=../../.env src/db/backfill-platform.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "@sbom/shared": "*",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.38.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "pdfjs-dist": "^6.2.108",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
