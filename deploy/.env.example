# SBOM Platform — deployment settings.
#
# Copy to `.env` next to docker-compose.yml and fill in the four required values.
# With a registry deployment these two files are the entire install: no repository,
# no Node, no PostgreSQL, no compiler.
#
# The start scripts (start.ps1 / start.sh) generate this file for you with strong
# random secrets. Write it by hand only when pulling images from a registry rather
# than loading them from a bundled images.tar.

# --- required ---------------------------------------------------------------

# Signs session cookies. 32+ random characters. Generate, do not invent:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
#
# Changing it later signs everyone out. Two machines sharing one value can forge
# each other's sessions, so generate a separate one per deployment.
SESSION_SECRET=

# The first administrator, created on first boot only. The "email" is a login
# identifier, not a mailbox — the platform never sends mail, so this need not be
# deliverable. There is no self-service password reset; another admin resets it.
BOOTSTRAP_ADMIN_EMAIL=admin@sbom.local
BOOTSTRAP_ADMIN_PASSWORD=

# --- images -----------------------------------------------------------------
# Leave these unset for both normal cases: the compose file already points at the
# published images, and an offline bundle's `docker load` provides them under the same
# tags. Set them only to run your own build, or to pin an older version.
#
# Pin a version rather than using `latest`: `latest` is what a machine gets when nobody
# chose, and having it move under a running deployment is an upgrade nobody triggered.
#SBOM_IMAGE_API=defaullltt/sbom-api:0.1.0
#SBOM_IMAGE_WEB=defaullltt/sbom-web:0.1.0

# --- recommended ------------------------------------------------------------

# How this deployment is actually reached. Affects the session cookie's Secure flag
# and the allowed CORS origin. The UI and API are same-origin behind nginx so the app
# works either way, but keeping it accurate matters once HTTPS is in front.
#PUBLIC_URL=http://sbom.internal.example.com:8080

# Shared bearer tokens for CI pipelines, as `label:token` pairs, comma-separated.
# Generate them the same way as SESSION_SECRET. A pipeline sends:
#   Authorization: Bearer <token>
#INGEST_TOKENS=jenkins:REPLACE_ME,gitlab:REPLACE_ME

# Host port for the UI. The API and PostgreSQL are deliberately not published.
#SBOM_PORT=8080

# PostgreSQL password. Only used inside the compose network, which is why it has a
# default at all — but set it anyway on a shared host.
#POSTGRES_PASSWORD=

# --- optional ---------------------------------------------------------------

# An active application with no build for this many days is reported as stale.
#STALE_APP_THRESHOLD_DAYS=30

# Vulnerability scanning is OFF until an administrator enables it in the admin panel;
# there is no environment variable for the flag. Grype ships inside the API image, but
# its database (~1.9 GB expanded) does not — install it once with "Update now", or by
# uploading an archive on a machine with no network. See README.md.
#
# Point at an internal mirror to keep database traffic inside the network.
#GRYPE_DB_UPDATE_URL=https://grype.anchore.io/databases
# For a mirror behind a TLS-inspecting proxy or a private CA (path inside the container).
#GRYPE_DB_CA_CERT=
# Ceiling for a hand-uploaded database archive, in bytes. Default 1 GiB against a current
# archive of ~145 MB, and deliberately not shared with INGEST_MAX_SBOM_BYTES — the air-
# gapped install path must not break when someone tightens the SBOM upload limit.
#GRYPE_DB_MAX_UPLOAD_BYTES=1073741824

#LOG_LEVEL=info
