# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
API_HOST=0.0.0.0

# Public origin of the app. Decides the allowed CORS origin and whether the
# session cookie gets the Secure flag (set automatically for https URLs).
PUBLIC_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://sbom:sbom@localhost:5432/sbom
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=72
SESSION_COOKIE_NAME=sbom_session

# ---------------------------------------------------------------------------
# Ingestion tokens (CI/CD -> POST /api/v1/scans)
# ---------------------------------------------------------------------------
# Bootstrap token(s) read from env, in addition to any tokens stored in the DB.
# Format: name:token, comma-separated. Lets you get CI working before the admin
# UI exists, and gives you a break-glass token if the DB rows get revoked.
INGEST_TOKENS=jenkins:replace-with-a-long-random-token,gitlab:replace-with-another
# Max accepted SBOM upload size in bytes (default 64 MiB).
INGEST_MAX_SBOM_BYTES=67108864

# ---------------------------------------------------------------------------
# Raw SBOM blob storage
# ---------------------------------------------------------------------------
# Driver: fs | s3
BLOB_STORE_DRIVER=fs
BLOB_STORE_FS_ROOT=./var/sboms
# Retention for the RAW SBOM BLOBS only. Scan rows are append-only and are
# never touched by this. 0 = keep raw blobs forever.
BLOB_RETENTION_DAYS=0

# s3 driver only
# BLOB_STORE_S3_ENDPOINT=https://s3.internal.example.com
# BLOB_STORE_S3_REGION=us-east-1
# BLOB_STORE_S3_BUCKET=sbom-raw
# BLOB_STORE_S3_ACCESS_KEY_ID=
# BLOB_STORE_S3_SECRET_ACCESS_KEY=
# BLOB_STORE_S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# There is none, deliberately. User "emails" are login identifiers, not
# mailboxes: the platform never sends invites, notifications, or password-reset
# links. Password recovery is an admin issuing a credential in the admin panel.
# No SMTP server is required to run this.

# ---------------------------------------------------------------------------
# Auth providers
# ---------------------------------------------------------------------------
# Comma-separated, in priority order. Only "local" is implemented in this
# phase; "ldap" is where the future provider plugs in.
AUTH_PROVIDERS=local

# ---------------------------------------------------------------------------
# Bootstrap admin (created on first migrate/seed if no users exist)
# ---------------------------------------------------------------------------
# A login identifier, not a deliverable address — admin@localhost is fine.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Leave blank to have one generated and printed by `npm run db:seed`. A
# generated password must be changed at first sign-in; a configured one is
# treated as already yours and is not forced.
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Features
# ---------------------------------------------------------------------------
# An application with no scan in this many days is flagged "stale" in the UI.
STALE_APP_THRESHOLD_DAYS=30
